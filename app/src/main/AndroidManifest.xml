<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.laundryapp">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Laundry App"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.expense.ExpenseHistoryActivity"
            android:exported="false"
            android:label="Riwayat Expense" />

        <activity
            android:name=".ui.about.AboutAppActivity"
            android:exported="false" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.auth.RegisterActivity" />

        <activity
            android:name=".MainActivity" />

        <activity
            android:name=".ui.customer.CustomerActivity" />

        <activity
            android:name=".ui.service.ServiceActivity" />

        <activity
            android:name=".ui.order.CreateOrderActivity" />

        <activity
            android:name=".ui.order.OrderHistoryActivity" />

        <activity
            android:name=".ui.payment.PaymentActivity" />

        <activity
            android:name=".ui.expense.ExpenseActivity" />

        <activity
            android:name=".ui.profile.ProfileActivity" />

        <activity
            android:name=".ui.notification.NotificationActivity" />

        <activity
            android:name=".ui.settings.SettingsActivity" />

        <activity
            android:name=".ui.help.HelpActivity" />

        <activity
            android:name=".ui.report.ReportActivity" />

    </application>

</manifest>